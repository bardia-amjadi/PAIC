<Page x:Class="PAIC.App.Pages.ProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PAIC.App.Pages">
  <ScrollViewer>
    <StackPanel Padding="32" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="Project" Style="{StaticResource TitleTextBlockStyle}" />
      <InfoBar x:Name="NoProjectBar" IsOpen="True" IsClosable="False" Severity="Informational"
               Title="No project is open" Message="Create or open a project from the Home page." />

      <StackPanel x:Name="Editor" Spacing="12" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
          <Button Content="Save as..." Click="SaveAs_Click" />
          <Button Content="Validate" Click="Validate_Click" />
          <Button Content="Close project" Click="Close_Click" />
        </StackPanel>

        <TextBox x:Name="NameBox" Header="Project name" TextChanged="Field_Changed" />
        <TextBox x:Name="ProductBox" Header="Product name" TextChanged="Field_Changed" />
        <TextBox x:Name="PublisherBox" Header="Publisher" TextChanged="Field_Changed" />
        <TextBox x:Name="VersionBox" Header="Version (e.g. 1.0.0)" TextChanged="Field_Changed" />
        <TextBox x:Name="WebsiteBox" Header="Website" TextChanged="Field_Changed" />
        <TextBox x:Name="DescriptionBox" Header="Description" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="80" TextChanged="Field_Changed" />
        <ComboBox x:Name="ArchitectureBox" Header="Target architecture" SelectionChanged="Architecture_Changed" />
        <TextBox x:Name="InstallDirBox" Header="Default install directory" TextChanged="Field_Changed" />
        <CheckBox x:Name="PerUserBox" Content="Install per-user (no elevation)" Checked="PerUser_Changed" Unchecked="PerUser_Changed" />

        <TextBlock x:Name="ValidationSummary" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
        <ListView x:Name="IssueList" SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:IssueRow">
              <StackPanel Padding="0,6">
                <TextBlock Text="{x:Bind Heading}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Opacity="0.8" Style="{StaticResource CaptionTextBlockStyle}" />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
