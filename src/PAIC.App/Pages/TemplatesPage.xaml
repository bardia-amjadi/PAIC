<Page x:Class="PAIC.App.Pages.TemplatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PAIC.App.Pages">
  <Grid Padding="24,16,24,16" ColumnSpacing="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Template Library" Style="{StaticResource TitleTextBlockStyle}" />
      <ListView x:Name="TemplateList" Grid.Row="1" ItemsSource="{x:Bind Items}" SelectionChanged="TemplateList_SelectionChanged">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:TemplateItem">
            <StackPanel Padding="0,6">
              <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
              <TextBlock Text="{x:Bind Subtitle}" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <StackPanel Grid.Row="2" Spacing="6">
        <Button Content="Import template..." HorizontalAlignment="Stretch" Click="Import_Click" />
        <Button x:Name="SaveProjectButton" Content="Save open project as template..." HorizontalAlignment="Stretch" Click="SaveProject_Click" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Column="1">
      <StackPanel x:Name="Details" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="CreateButton" Content="Create project from template..." Style="{StaticResource AccentButtonStyle}" Click="Create_Click" />
          <Button x:Name="ExportButton" Content="Export..." Click="Export_Click" />
          <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" />
        </StackPanel>
        <TextBlock Text="Theme" FontWeight="SemiBold" />
        <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Spacing="4" />
        <TextBlock Text="Contents" FontWeight="SemiBold" />
        <TextBlock x:Name="ContentsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
