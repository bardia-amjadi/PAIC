<Page x:Class="PAIC.App.Pages.DesignerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PAIC.App.Pages">
  <Grid Padding="12,8,12,8" RowSpacing="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <InfoBar x:Name="NoProjectBar" IsOpen="True" IsClosable="False" Severity="Informational"
             Title="No project is open" Message="Create or open a project to design its installer pages." />

    <!-- Toolbar -->
    <CommandBar x:Name="Toolbar" Grid.Row="1" DefaultLabelPosition="Right" Visibility="Collapsed" Background="Transparent" HorizontalAlignment="Left">
      <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" Click="Undo_Click" />
      <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" Click="Redo_Click" />
      <AppBarSeparator />
      <AppBarButton Icon="Cut" Label="Cut" Click="Cut_Click" />
      <AppBarButton Icon="Copy" Label="Copy" Click="Copy_Click" />
      <AppBarButton Icon="Paste" Label="Paste" Click="Paste_Click" />
      <AppBarButton Icon="Add" Label="Duplicate" Click="Duplicate_Click" />
      <AppBarButton Icon="Delete" Label="Delete" Click="Delete_Click" />
      <AppBarSeparator />
      <AppBarButton Icon="AllApps" Label="Group" Click="Group_Click" />
      <AppBarButton Icon="Cancel" Label="Ungroup" Click="Ungroup_Click" />
      <AppBarButton Icon="AlignLeft" Label="Align">
        <AppBarButton.Flyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="Align left" Click="AlignLeft_Click" />
            <MenuFlyoutItem Text="Center horizontally" Click="AlignCenterH_Click" />
            <MenuFlyoutItem Text="Align right" Click="AlignRight_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Align top" Click="AlignTop_Click" />
            <MenuFlyoutItem Text="Center vertically" Click="AlignCenterV_Click" />
            <MenuFlyoutItem Text="Align bottom" Click="AlignBottom_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Distribute horizontally" Click="DistributeH_Click" />
            <MenuFlyoutItem Text="Distribute vertically" Click="DistributeV_Click" />
            <MenuFlyoutItem Text="Set horizontal spacing..." Click="SpacingH_Click" />
            <MenuFlyoutItem Text="Set vertical spacing..." Click="SpacingV_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Match width" Click="MatchWidth_Click" />
            <MenuFlyoutItem Text="Match height" Click="MatchHeight_Click" />
          </MenuFlyout>
        </AppBarButton.Flyout>
      </AppBarButton>
      <AppBarButton Icon="Sort" Label="Order">
        <AppBarButton.Flyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="Bring to front" Click="ToFront_Click" />
            <MenuFlyoutItem Text="Bring forward" Click="Forward_Click" />
            <MenuFlyoutItem Text="Send backward" Click="Backward_Click" />
            <MenuFlyoutItem Text="Send to back" Click="ToBack_Click" />
          </MenuFlyout>
        </AppBarButton.Flyout>
      </AppBarButton>
      <AppBarSeparator />
      <AppBarToggleButton x:Name="SnapToggle" Icon="ViewAll" Label="Snap" IsChecked="True" Click="Snap_Click" />
      <AppBarToggleButton x:Name="PreviewToggle" Icon="View" Label="Preview" Click="PreviewToggle_Click" />
      <CommandBar.SecondaryCommands>
        <AppBarButton Label="Validate project" Click="Validate_Click" />
      </CommandBar.SecondaryCommands>
      <CommandBar.Content>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Zoom" VerticalAlignment="Center" />
          <ComboBox x:Name="ZoomBox" Width="90" SelectionChanged="Zoom_Changed" />
        </StackPanel>
      </CommandBar.Content>
    </CommandBar>

    <InfoBar x:Name="StateBar" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Informational">
      <InfoBar.ActionButton>
        <Button x:Name="StateButton" Content="" Click="StateButton_Click" />
      </InfoBar.ActionButton>
    </InfoBar>

    <Grid x:Name="Workspace" Grid.Row="3" ColumnSpacing="10" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>

      <!-- Left: pages, toolbox, custom controls -->
      <ScrollViewer>
        <StackPanel Spacing="8" Padding="0,0,8,0">
          <TextBlock Text="Pages" Style="{StaticResource SubtitleTextBlockStyle}" />
          <ListView x:Name="PageList" ItemsSource="{x:Bind Pages}" MaxHeight="220" SelectionChanged="PageList_SelectionChanged">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:PageItem">
                <StackPanel Padding="0,4">
                  <TextBlock Text="{x:Bind Title}" />
                  <TextBlock Text="{x:Bind Subtitle}" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Add" Click="AddPage_Click" />
            <Button Content="Copy" Click="DuplicatePage_Click" />
            <Button Content="Delete" Click="RemovePage_Click" />
            <Button Content="&#x25B2;" Click="PageUp_Click" ToolTipService.ToolTip="Move page up" />
            <Button Content="&#x25BC;" Click="PageDown_Click" ToolTipService.ToolTip="Move page down" />
          </StackPanel>
          <Button Content="Reset page to default layout" Click="ResetLayout_Click" />

          <TextBlock x:Name="ToolboxTitle" Text="Toolbox" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
          <TextBlock Text="Drag onto the page, or double-click to add." Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
          <ListView x:Name="ToolList" ItemsSource="{x:Bind Tools}" CanDragItems="True" SelectionMode="Single"
                    DragItemsStarting="ToolList_DragItemsStarting" DoubleTapped="ToolList_DoubleTapped" MaxHeight="300">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:ToolItem">
                <StackPanel Padding="0,3">
                  <TextBlock Text="{x:Bind Title}" />
                  <TextBlock Text="{x:Bind Category}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <TextBlock Text="Custom controls" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
          <ListView x:Name="ControlList" ItemsSource="{x:Bind CustomControls}" MaxHeight="140" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:ControlItem">
                <TextBlock Text="{x:Bind Title}" Padding="0,3" />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel Spacing="4">
            <Button Content="Create from selection..." Click="CreateControl_Click" HorizontalAlignment="Stretch" />
            <Button Content="Edit selected control" Click="EditControl_Click" HorizontalAlignment="Stretch" />
            <Button Content="Remove selected control" Click="RemoveControl_Click" HorizontalAlignment="Stretch" />
            <Button Content="Save to library" Click="ControlToLibrary_Click" HorizontalAlignment="Stretch" />
            <Button Content="Add from library..." Click="ControlFromLibrary_Click" HorizontalAlignment="Stretch" />
            <Button Content="Import control file..." Click="ImportControl_Click" HorizontalAlignment="Stretch" />
            <Button Content="Export control file..." Click="ExportControl_Click" HorizontalAlignment="Stretch" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Centre: design surface and preview -->
      <Grid Grid.Column="1">
        <Border BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" CornerRadius="6"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
          <ScrollViewer x:Name="DesignScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
            <Grid x:Name="ZoomHost" Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Grid x:Name="Surface" AllowDrop="True" IsTabStop="True" Background="Transparent"
                    PointerPressed="Surface_PointerPressed" PointerMoved="Surface_PointerMoved" PointerReleased="Surface_PointerReleased"
                    PointerCanceled="Surface_PointerCanceled" KeyDown="Surface_KeyDown" DragOver="Surface_DragOver" Drop="Surface_Drop"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid x:Name="RenderHost" />
                <Canvas x:Name="Overlay" IsHitTestVisible="False" />
              </Grid>
            </Grid>
          </ScrollViewer>
        </Border>

        <!-- Preview -->
        <Grid x:Name="PreviewPanel" Visibility="Collapsed" RowSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" Padding="4">
            <ComboBox x:Name="PvThemeBox" Header="Theme" Width="170" SelectionChanged="PreviewOption_Changed" />
            <ComboBox x:Name="PvSizeBox" Header="Window size" Width="170" SelectionChanged="PreviewOption_Changed" />
            <ComboBox x:Name="PvDpiBox" Header="Display scale" Width="120" SelectionChanged="PreviewOption_Changed" />
            <ComboBox x:Name="PvPageBox" Header="Go to page" Width="190" SelectionChanged="PvPage_Changed" />
            <Slider x:Name="PvProgress" Header="Install progress (simulated)" Width="160" Minimum="0" Maximum="100" Value="40" ValueChanged="PvProgress_Changed" />
            <Button Content="Restart" VerticalAlignment="Bottom" Click="PvRestart_Click" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Grid x:Name="PvHost" />
            </Grid>
          </ScrollViewer>
          <Grid Grid.Row="2" RowSpacing="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PvStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            <Expander Grid.Row="1" Header="Variables (edit to test conditions)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <ScrollViewer MaxHeight="180"><StackPanel x:Name="PvVariables" Spacing="4" /></ScrollViewer>
            </Expander>
          </Grid>
        </Grid>
      </Grid>

      <!-- Right: inspector and layers -->
      <Grid Grid.Column="2" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="220" />
        </Grid.RowDefinitions>
        <ScrollViewer>
          <StackPanel x:Name="InspectorPanel" Spacing="8" Padding="0,0,8,0" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Layers" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Content="Hide/Show" Click="ToggleVisible_Click" />
          <Button Content="Lock" Click="ToggleLock_Click" />
          <Button Content="&#x25B2;" Click="Forward_Click" ToolTipService.ToolTip="Bring forward" />
          <Button Content="&#x25BC;" Click="Backward_Click" ToolTipService.ToolTip="Send backward" />
        </StackPanel>
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" CornerRadius="6">
          <TreeView x:Name="LayerTree" SelectionMode="Single" SelectionChanged="LayerTree_SelectionChanged">
            <TreeView.ItemTemplate>
              <DataTemplate x:DataType="local:LayerNode">
                <TreeViewItem ItemsSource="{x:Bind Children}" Content="{x:Bind Title}" IsExpanded="True" />
              </DataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Page>
