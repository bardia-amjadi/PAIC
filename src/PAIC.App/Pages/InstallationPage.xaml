<Page x:Class="PAIC.App.Pages.InstallationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PAIC.App.Pages">
  <Page.Resources>
    <DataTemplate x:Key="ItemTemplate" x:DataType="local:ListItem">
      <StackPanel Padding="0,5">
        <TextBlock Text="{x:Bind Title}" />
        <TextBlock Text="{x:Bind Subtitle}" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid Padding="24,16,24,16" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="Installation" Style="{StaticResource TitleTextBlockStyle}" />
    <InfoBar x:Name="NoProjectBar" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational"
             Title="No project is open" Message="Create or open a project to configure what its installer does." />

    <Pivot x:Name="Tabs" Grid.Row="2" Visibility="Collapsed">
      <PivotItem Header="Components">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid RowSpacing="6">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ListView x:Name="ComponentList" ItemsSource="{x:Bind Components}" ItemTemplate="{StaticResource ItemTemplate}" SelectionChanged="ComponentList_SelectionChanged" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Add" Click="AddComponent_Click" />
              <Button Content="Remove" Click="RemoveComponent_Click" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Column="1"><StackPanel x:Name="ComponentForm" Spacing="8" MaxWidth="620" HorizontalAlignment="Left" /></ScrollViewer>
        </Grid>
      </PivotItem>

      <PivotItem Header="Operations">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid RowSpacing="6">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ListView x:Name="OperationList" ItemsSource="{x:Bind Operations}" ItemTemplate="{StaticResource ItemTemplate}" SelectionChanged="OperationList_SelectionChanged" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Add..." Click="AddOperation_Click" />
              <Button Content="Copy" Click="DuplicateOperation_Click" />
              <Button Content="Remove" Click="RemoveOperation_Click" />
              <Button Content="&#x25B2;" Click="OperationUp_Click" ToolTipService.ToolTip="Run earlier" />
              <Button Content="&#x25BC;" Click="OperationDown_Click" ToolTipService.ToolTip="Run later" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Column="1"><StackPanel x:Name="OperationForm" Spacing="8" MaxWidth="620" HorizontalAlignment="Left" /></ScrollViewer>
        </Grid>
      </PivotItem>

      <PivotItem Header="Prerequisites">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid RowSpacing="6">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ListView x:Name="PrerequisiteList" ItemsSource="{x:Bind Prerequisites}" ItemTemplate="{StaticResource ItemTemplate}" SelectionChanged="PrerequisiteList_SelectionChanged" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Add" Click="AddPrerequisite_Click" />
              <Button Content="Remove" Click="RemovePrerequisite_Click" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Column="1"><StackPanel x:Name="PrerequisiteForm" Spacing="8" MaxWidth="620" HorizontalAlignment="Left" /></ScrollViewer>
        </Grid>
      </PivotItem>

      <PivotItem Header="Test">
        <Grid RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                     Text="Tests run against a virtual machine in a temporary folder: files are really copied, but the registry, environment variables, services, permissions and prerequisites are simulated, so nothing on this computer is changed. To test on the real machine, use the paic-installer command line with --dry-run first." />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Check plan" Click="Plan_Click" />
            <Button Content="Run test install (install, verify, repair, uninstall)" Click="Cycle_Click" />
            <Button Content="Validate" Click="Validate_Click" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24" />
          </StackPanel>
          <TextBox x:Name="TestOutput" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
