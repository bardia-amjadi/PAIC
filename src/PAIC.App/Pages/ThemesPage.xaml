<Page x:Class="PAIC.App.Pages.ThemesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PAIC.App.Pages">
  <Grid Padding="24,16,24,16" ColumnSpacing="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Theme list and actions -->
    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Theme Studio" Style="{StaticResource TitleTextBlockStyle}" />
      <ListView x:Name="ThemeList" Grid.Row="1" ItemsSource="{x:Bind Items}" SelectionChanged="ThemeList_SelectionChanged">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:ThemeItem">
            <StackPanel Padding="0,6">
              <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
              <TextBlock Text="{x:Bind Subtitle}" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <StackPanel Grid.Row="2" Spacing="6">
        <Button x:Name="AddButton" Content="Add to project" HorizontalAlignment="Stretch" Click="AddToProject_Click" />
        <Button x:Name="ActiveButton" Content="Set as active theme" HorizontalAlignment="Stretch" Click="SetActive_Click" />
        <Button x:Name="DuplicateButton" Content="Duplicate" HorizontalAlignment="Stretch" Click="Duplicate_Click" />
        <Button x:Name="RemoveButton" Content="Remove from project" HorizontalAlignment="Stretch" Click="Remove_Click" />
        <Button x:Name="LibraryButton" Content="Save to library" HorizontalAlignment="Stretch" Click="SaveToLibrary_Click" />
        <Button x:Name="DeleteLibraryButton" Content="Delete from library" HorizontalAlignment="Stretch" Click="DeleteFromLibrary_Click" />
        <Button Content="Import theme file..." HorizontalAlignment="Stretch" Click="Import_Click" />
        <Button x:Name="ExportButton" Content="Export theme file..." HorizontalAlignment="Stretch" Click="Export_Click" />
      </StackPanel>
    </Grid>

    <!-- Editor and preview -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
        <InfoBar x:Name="StateBar" IsOpen="True" IsClosable="False" Severity="Informational" />
        <StackPanel x:Name="EditorPanel" Spacing="12" Visibility="Collapsed">
          <TextBox x:Name="NameBox" Header="Name" TextChanged="Name_Changed" />
          <TextBlock x:Name="IdText" Opacity="0.7" />
          <ComboBox x:Name="ModeBox" Header="Mode" SelectionChanged="Mode_Changed" />
          <ComboBox x:Name="MaterialBox" Header="Window material" SelectionChanged="Material_Changed" />
          <ComboBox x:Name="BackgroundImageBox" Header="Background image (project asset)" SelectionChanged="BackgroundImage_Changed" />

          <TextBlock Text="Colours" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
          <StackPanel x:Name="ColorsPanel" Spacing="6" />

          <TextBlock Text="Typography" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
          <TextBox x:Name="FontFamilyBox" Header="Font family" TextChanged="FontFamily_Changed" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <NumberBox x:Name="CaptionBox" Header="Caption" Minimum="8" Maximum="96" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
            <NumberBox x:Name="BodyBox" Header="Body" Minimum="8" Maximum="96" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
            <NumberBox x:Name="SubtitleBox" Header="Subtitle" Minimum="8" Maximum="96" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
            <NumberBox x:Name="TitleBox" Header="Title" Minimum="8" Maximum="96" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
          </StackPanel>

          <TextBlock Text="Shape and spacing" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <NumberBox x:Name="RadiusBox" Header="Corner radius" Minimum="0" Maximum="32" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
            <NumberBox x:Name="HeightBox" Header="Control height" Minimum="20" Maximum="64" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
            <NumberBox x:Name="SpacingBox" Header="Spacing" Minimum="0" Maximum="48" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
          </StackPanel>

          <TextBlock Text="Validation" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
          <TextBlock x:Name="ValidationText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>

        <TextBlock x:Name="PreviewHeader" Text="Preview" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" Visibility="Collapsed" />
        <Border x:Name="PreviewFrame" Padding="20" BorderThickness="1" Visibility="Collapsed">
          <StackPanel Spacing="10">
            <TextBlock x:Name="PvTitle" Text="Install Contoso Notes" />
            <TextBlock x:Name="PvBody" Text="Choose where to install and press Install." TextWrapping="Wrap" />
            <Border x:Name="PvCard" Padding="12" BorderThickness="1">
              <TextBlock x:Name="PvCardText" Text="Folder: C:\Program Files\Contoso Notes" />
            </Border>
            <ProgressBar x:Name="PvProgress" Value="60" Maximum="100" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock x:Name="PvSuccess" Text="Ready" />
              <TextBlock x:Name="PvWarning" Text="Restart required" />
              <TextBlock x:Name="PvError" Text="Disk full" />
            </StackPanel>
            <Border x:Name="PvButton" Padding="20,0" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock x:Name="PvButtonText" Text="Install" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
